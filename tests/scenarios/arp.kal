# the arpeggiator (ARP: Arp, Arp 2): held notes feed it, it plays them in turn at its rate; off, the keys
# strike again. The steel still plays at once.
# (params: 36 Tempo 41 Mode 42 Rate 43 Octaves 44 Gate 45 Swing 46 Chance 47 Hold 48 Order)
wav arp.wav
wait 1300
tap ARP
expect view 11
expect par41 0
# Mode Up: D3 (white 8) and A3 (white 9) held: D3 first (at once, as it goes down), then A3, at the
# default 1/16 of 84 BPM (179 ms)
spin K1 1
expect par41 1
key w8 down
key w9 down
wait 20
expect arpheld 2
expect outn 1
expect outlast 5000
expect note5000 >5
wait 179
expect outn 2
expect outlast 5700
expect note5700 >5
wait 400
expect outn 4
leds
shot arp.png
# let go: it stops
key w9 up
key w8 up
wait 600
expect arpheld 0
expect outn 4
# Down: the high one first
spin K1 1
expect par41 2
key w9 down
key w8 down
wait 20
expect outlast 5700
wait 179
expect outlast 5000
key w8 up
key w9 up
# Octaves 2, Up: D3 A3 D4 A4
spin K1 -1
spin K3 1
expect par43 2
key w8 down
key w9 down
wait 400
expect outlast 6200
wait 179
expect outlast 6900
key w8 up
key w9 up
spin K3 -1
# Arp 2: Hold latches the notes; a new key after them replaces them
tap ARP
expect view 12
shot arp2.png
spin K3 1
expect par47 1
tapkey w8
wait 400
expect arpheld 1
expect outlast 5000
tapkey w10
wait 1300
expect arpheld 1
expect outlast 6000
# Chance 0: nothing plays
spin K2 -127
expect par46 0
wait 400
expect outlast 6000
spin K2 127
spin K3 -1
expect par47 0
wait 50
expect arpheld 0
# the steel plays at once, the arp or not
tapkey w0
wait 20
expect shellL >5
# Mode off: the keys strike again (the arp quiet)
tap ARP
expect view 11
spin K1 -9
expect par41 0
wait 1500
tapkey w5
wait 20
expect note6200 >5
expect outlast 6000
wavstop
expect dropped 0
