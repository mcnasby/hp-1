# the project survives a restart: SAVE, then autosave after a quiet moment; a FiMba-1 project is not
# taken for one (params: 0 Metal 3 Harmonics 16 Grains 24 Scale 25 Key)
wait 50
spin K1 3
expect par0 3
tap SAVE
expect store_writes 1
expect dirty 0
reboot
expect par0 3
# a change saves itself four seconds after the last touch, once the pan is quiet
spin K4 -30
expect par3 30
expect dirty 1
wait 3000
expect store_writes 1
wait 2000
expect store_writes 2
expect dirty 0
reboot
expect par3 30
# a scale and a key: A Celtic
tap SEL
spin K2 1
spin K3 7
expect par24 1
expect par25 9
expect white8 4500
tap SAVE
reboot
expect par25 9
expect white8 4500
# live grains don't hold autosave back...
tap LFO
spin K1 30
expect par16 30
wait 6000
expect dirty 0
# ...frozen ones do: an erase would cut the drone
tapkey w7
tap PLAY
expect frozen 3
tap HOME
spin K2 5
wait 6000
expect dirty 1
tap PLAY
wait 6000
expect dirty 0
# a FiMba-1 project in the flash: the defaults, not its values
oldproject
reboot
expect par0 0
expect par24 0
