# the steel on the white keys at both ends (thwap outside, tak inside); the black keys the kit:
# castanets, the cabasa pushed, the steel's Gu, ghost, ding slap, tak, harmonic, rim, mute, the cabasa
# pulled, a splash cymbal; REC mutes too
# (params: 26 Black 29 Percussion; shellL / shellR / cavity: x 1000)
wav steel.wav
wait 1600
expect par26 0
key w0 down
wait 30
expect shellL >5
shot thwap.png
key w0 up
wait 300
key w15 down
wait 20
expect shellR >5
key w15 up
wait 300
tapkey w1
wait 300
tapkey w14
wait 300
# the kit's own sounds: not the steel (the shell stays still), but heard
wait 1500
peakreset
key b10 down
wait 60
expect peak_db_min -30
expect shellL 0
expect shellR 0
shot kit.png
key b10 up
wait 1500
peakreset
tapkey b1
wait 120
expect peak_db_min -30
wait 400
peakreset
tapkey b9
wait 120
expect peak_db_min -30
wait 400
peakreset
tapkey b0
wait 40
expect peak_db_min -30
expect shellL 0
wait 300
# the Gu: the air inside
key b2 down
wait 25
expect cavity >5
shot gu.png
key b2 up
wait 400
tapkey b3
wait 200
# the ding slap: it sounds, then the palm closes it
key b4 down
wait 20
expect note5000 >5
key b4 up
wait 400
expect note5000 <3
tapkey b5
wait 200
# the harmonic: the ding again, its octave singing
tapkey b6
wait 50
expect note5000 >1
wait 400
tapkey b7
wait 300
# mute: everything ringing, damped
tapkey w8
tapkey w6
tapkey w9
wait 100
expect note5700 >5
tapkey b8
wait 500
expect note5700 <2
expect note5000 <2
# REC: the palm mute too
tapkey w5
wait 100
expect note6200 >5
tap REC
wait 500
expect note6200 <2
# the keys light while they sound
tapkey w0
tapkey b10
leds
# Percussion 0: the steel and the kit are silent
tap SEL
tap SEL
expect view 8
spin K3 -70
expect par29 0
wait 2000
peakreset
tapkey w0
tapkey w1
tapkey b10
tapkey b0
wait 200
expect shellL 0
expect peak_db_max -58
spin K3 70
wait 2000
wavstop
expect peak_db_max -0.3
expect dropped 0
