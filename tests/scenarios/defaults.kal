# the defaults and getting back to them: D Kurd, Nitrided, Kit, MIDI out off, the Dark theme; SAVE
# held: reset to the defaults (asked first)
# (params: 0 Metal 1 Strike 24 Scale 25 Key 26 Black 39 MIDI out 40 Theme)
wait 50
expect par0 0
expect par24 0
expect par25 2
expect par26 0
expect par39 0
expect par40 0
# the ding's keys glow dim (white 7, 8), its field's beside them (6, 9) just lit; while it rings the ding's are lit,
# its field's to 40 %; a note's key, a thwap's to 80 % (ledwW: white key W's LED, 100 80 40 20 5 0)
wait 50
expect ledw7 20
expect ledw8 20
expect ledw6 5
expect ledw9 5
expect ledw10 0
tapkey w8
wait 30
expect ledw8 100
expect ledw7 100
expect ledw6 40
expect ledw9 40
tapkey w10
wait 30
expect ledw10 100
tapkey w0
wait 30
expect ledw0 80
# (REC held: the palm mute)
press REC
wait 600
release REC
wait 400
expect ledw8 20
expect ledw9 5
expect ledw10 0
# change a sound and the Setup page
spin K2 20
expect par1 60
tap GLO
spin K4 1
spin K3 1
expect par40 1
expect par39 1
# SAVE held: asked, nothing saved, nothing reset yet
press SAVE
wait 1700
release SAVE
wait 50
expect dirty 1
expect par1 60
shot reset_ask.png
# any other button: kept
tap HOME
expect par1 60
# asked again, and SAVE: the sounds back to their defaults, the Setup page as it was
press SAVE
wait 1700
release SAVE
tap SAVE
expect par1 40
expect par40 1
expect par39 1
expect dirty 1
# not answered in 5 s: kept
tap HOME
spin K2 5
expect par1 45
press SAVE
wait 1700
release SAVE
wait 5200
expect par1 45
tap SAVE
expect dirty 0
