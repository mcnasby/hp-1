# the defaults and getting back to them: D Kurd, Nitrided, Kit, MIDI out off, the Dark theme; SAVE
# held: reset to the defaults (asked first)
# (params: 0 Metal 1 Strike 24 Scale 25 Key 26 Black 39 MIDI out 40 Theme)
wait 50
expect par0 0
expect par24 0
expect par25 2
expect par26 0
expect par39 0
expect par40 0
# the ding's keys glow dim (white 7 and 8: keys 12 and 14); lit while it rings
wait 50
expect dimkey 14
tapkey w8
wait 30
expect dimkey -1
tap REC
wait 400
expect dimkey 14
# change a sound and the Setup page
spin K2 20
expect par1 60
tap GLO
spin K4 1
spin K3 1
expect par40 1
expect par39 1
# SAVE held: asked, nothing saved, nothing reset yet
press SAVE
wait 1700
release SAVE
wait 50
expect dirty 1
expect par1 60
shot reset_ask.png
# any other button: kept
tap HOME
expect par1 60
# asked again, and SAVE: the sounds back to their defaults, the Setup page as it was
press SAVE
wait 1700
release SAVE
tap SAVE
expect par1 40
expect par40 1
expect par39 1
expect dirty 1
# not answered in 5 s: kept
tap HOME
spin K2 5
expect par1 45
press SAVE
wait 1700
release SAVE
wait 5200
expect par1 45
tap SAVE
expect dirty 0
